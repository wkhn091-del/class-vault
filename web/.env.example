# Local: point at your Express server.
VITE_API_URL=http://localhost:4000
# Production: set this in Vercel, e.g.
# VITE_API_URL=https://class-vault-api.onrender.com

# Interface language and direction: he (RTL) or en (LTR).
VITE_LOCALE=he

# Shown in the header and on the home page.
VITE_CLASS_NAME=ארכיון הכיתה
VITE_CLASS_SUBTITLE=סיכומים, מבחנים ומצגות — הכול במקום אחד.

# Empty = same-origin (recommended). Local Vite proxies /api → localhost:4000.
VITE_API_URL=
# Only set this if the API is on a different host:
# VITE_API_URL=https://your-api.example.com

# Interface language and direction: he (RTL) or en (LTR).
VITE_LOCALE=he

# Brand — המתיבתא
VITE_CLASS_NAME=המתיבתא
VITE_CLASS_SUBTITLE=סיכומים, מבחנים ומצגות — במקום אחד
VITE_CLASS_TAGLINE=תורה ודעת
